# Supabase > Project Settings > API. Never use a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Your permanent production domain, including https:// and no trailing slash.
NEXT_PUBLIC_APP_URL=
# Email of your only authorized panel user (created in Supabase Authentication).
ADMIN_EMAIL=
# Optional. Initial destination of the NFC and menu links created with each venue (edit them later).
NEXT_PUBLIC_DEFAULT_DESTINATION_URL=
